# Windows Wi-Fi IPv4 address; do not use localhost or Docker/WSL internal IP here.
PUBLIC_URL=http://192.168.1.8:9100
PORT=9100
TEXT_CHARS=100000
FILE_BYTES=50000000
BATCH_COUNT=20
SESSION_BYTES=200000000
IDLE_MS=1800000
PAIR_MS=300000
# Empty receiver sessions with no heartbeat or activity can be reclaimed after this grace period.
RECEIVER_GRACE_MS=120000
MAX_SESSIONS=10
